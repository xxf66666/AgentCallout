{
  "version": "1.1",
  "coordinateSpace": "pixel",
  "preset": "docs-light",
  "defaults": {
    "fontSize": 20,
    "maxWidth": 260
  },
  "annotations": [
    {
      "id": "email-note",
      "type": "callout",
      "target": {
        "x": 255,
        "y": 250,
        "width": 500,
        "height": 44
      },
      "text": "普通隐私：视觉弱化",
      "placement": "right",
      "tone": "info"
    },
    {
      "id": "token-note",
      "type": "callout",
      "target": {
        "x": 255,
        "y": 372,
        "width": 515,
        "height": 46
      },
      "text": "Token：不可恢复遮挡",
      "placement": "top",
      "tone": "danger"
    },
    {
      "id": "email-blur",
      "type": "blur",
      "rect": {
        "x": 255,
        "y": 250,
        "width": 500,
        "height": 44
      },
      "sigma": 12
    },
    {
      "id": "token-redact",
      "type": "redact",
      "rect": {
        "x": 255,
        "y": 372,
        "width": 515,
        "height": 46
      },
      "color": "#111827"
    }
  ]
}
